# Copy to .env for local use (python-dotenv), or set in Render / Streamlit Cloud.

# production | development
ENVIRONMENT=development

# --- API hardening (FastAPI) ---
# If set, all routes except GET /health require:
#   Authorization: Bearer <value>   OR   X-API-Key: <value>
API_SECRET_KEY=

# Comma-separated browser origins for CORS (use your Streamlit URL in production).
# CORS_ORIGINS=https://your-app.streamlit.app

# Max HTTP requests per client IP per minute (0 = disabled).
# RATE_LIMIT_PER_MINUTE=120

# Behind Render/nginx: trust X-Forwarded-For for client IP (rate limit + logs).
# TRUST_PROXY_HEADERS=true

# Hide /docs and OpenAPI JSON in production unless you set this.
# EXPOSE_OPENAPI=false
